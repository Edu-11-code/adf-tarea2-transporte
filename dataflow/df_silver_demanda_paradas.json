{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"derivedColumn2 derive(DemandaId = trim(toString(DemandaId)),",
				"          FechaServicio = iif(\r",
				"    isNull(FechaServicio),\r",
				"    toDate(null()),\r",
				"    iif(\r",
				"        instr(FechaServicio, '/') > 0,\r",
				"        toDate(FechaServicio, 'dd/MM/yyyy'),\r",
				"        iif(\r",
				"            length(FechaServicio) == 5,\r",
				"            addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(FechaServicio)),\r",
				"            toDate(FechaServicio, 'yyyy-MM-dd')\r",
				"        )\r",
				"    )\r",
				"),",
				"          RutaHistoricaId = trim(RutaHistoricaId),",
				"          ParadaHistoricaId = upper(trim(ParadaHistoricaId)),",
				"          Franja = trim(Franja),",
				"          ValidacionesTarjeta = toInteger(ValidacionesTarjeta),",
				"          Descensos = toInteger(Descensos),",
				"          DemandaNoAtendida = toInteger(DemandaNoAtendida),",
				"          Metodo = upper(trim(Metodo))) ~> derivedColumn1",
				"source1 derive(DemandaId = iif(\r",
				"    isNull(DemandaId) || trim(DemandaId) == '',\r",
				"    concat(\r",
				"        'D-',\r",
				"        toString(FechaServicio, 'yyyyMMdd'),\r",
				"        '-',\r",
				"        RutaHistoricaId,\r",
				"        '-',\r",
				"        ParadaHistoricaId\r",
				"    ),\r",
				"    DemandaId\r",
				")) ~> derivedColumn2",
				"derivedColumn1 derive(ParadaHistoricaId = iif(     isNull(ParadaHistoricaId) || trim(ParadaHistoricaId) == '',     toString(null()),     concat(         trim(ParadaHistoricaId),         '-',         toString(year(FechaServicio))     ) ),",
				"          RutaHistoricaId = iif(\r",
				"    isNull(RutaHistoricaId) || trim(RutaHistoricaId) == '',\r",
				"    toString(null()),\r",
				"    iif(\r",
				"        startsWith(upper(trim(RutaHistoricaId)), 'RUTA '),\r",
				"        iif(\r",
				"            length(trim(substring(trim(RutaHistoricaId), 6, 20))) == 1,\r",
				"            concat('RH-0', trim(substring(trim(RutaHistoricaId), 6, 20))),\r",
				"            concat('RH-', trim(substring(trim(RutaHistoricaId), 6, 20)))\r",
				"        ),\r",
				"        iif(\r",
				"            startsWith(upper(trim(RutaHistoricaId)), 'R-'),\r",
				"            concat('RH-', substring(trim(RutaHistoricaId), 3, 20)),\r",
				"            iif(\r",
				"                startsWith(upper(trim(RutaHistoricaId)), 'RH-'),\r",
				"                upper(trim(RutaHistoricaId)),\r",
				"                iif(\r",
				"                    length(trim(RutaHistoricaId)) == 2,\r",
				"                    concat('RH-', trim(RutaHistoricaId)),\r",
				"                    upper(trim(RutaHistoricaId))\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				")) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}