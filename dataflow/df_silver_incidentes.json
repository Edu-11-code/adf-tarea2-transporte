{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = trim(IncidenteId),",
				"          TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad)),",
				"          FechaHoraInicio = iif(\r",
				"    isNull(FechaHoraInicio) || trim(toString(FechaHoraInicio)) == '',\r",
				"    toTimestamp(null()),\r",
				"    iif(\r",
				"        instr(toString(FechaHoraInicio), '1899-12-31') > 0,\r",
				"        toTimestamp(\r",
				"            concat(\r",
				"                substring(toString(FechaHoraInicio), 1, 10),\r",
				"                ' ',\r",
				"                substring(toString(FechaHoraInicio), 22, 8)\r",
				"            ),\r",
				"            'yyyy-MM-dd HH:mm:ss'\r",
				"        ),\r",
				"        toTimestamp(FechaHoraInicio)\r",
				"    )\r",
				"),",
				"          FechaHoraFin = iif(     isNull(FechaHoraFin) || trim(toString(FechaHoraFin)) == '',     toTimestamp(null()),     iif(         instr(toString(FechaHoraFin), '1899-12-31') > 0,         toTimestamp(             concat(                 substring(toString(FechaHoraFin), 1, 10),                 ' ',                 substring(toString(FechaHoraFin), 22, 8)             ),             'yyyy-MM-dd HH:mm:ss'         ),         toTimestamp(FechaHoraFin)     ) ),",
				"          FechaHoraRegistro = iif(     isNull(FechaHoraRegistro) || trim(toString(FechaHoraRegistro)) == '',     toTimestamp(null()),     iif(         instr(toString(FechaHoraRegistro), '1899-12-31') > 0,         toTimestamp(             concat(                 substring(toString(FechaHoraRegistro), 1, 10),                 ' ',                 substring(toString(FechaHoraRegistro), 22, 8)             ),             'yyyy-MM-dd HH:mm:ss'         ),         toTimestamp(FechaHoraRegistro)     ) ),",
				"          VehiculoId = iif(\r",
				"    isNull(VehiculoId) || trim(toString(VehiculoId)) == '',\r",
				"    toString(null()),\r",
				"    trim(toString(VehiculoId))\r",
				"),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}