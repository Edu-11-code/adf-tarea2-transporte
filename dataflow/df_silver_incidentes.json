{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = trim(IncidenteId),",
				"          TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad)),",
				"          FechaHoraInicio = iif(     isNull(FechaHoraInicio) || trim(toString(FechaHoraInicio)) == '',     toTimestamp(null()),     toTimestamp(trim(toString(FechaHoraInicio)), 'dd/MM/yyyy HH:mm') ),",
				"          FechaHoraFin = iif(     isNull(FechaHoraFin) || trim(toString(FechaHoraFin)) == '',     toTimestamp(null()),     toTimestamp(trim(toString(FechaHoraFin)), 'dd/MM/yyyy HH:mm') ),",
				"          FechaHoraRegistro = iif(     isNull(FechaHoraRegistro) || trim(toString(FechaHoraRegistro)) == '',     toTimestamp(null()),     toTimestamp(trim(toString(FechaHoraRegistro)), 'dd/MM/yyyy') ),",
				"          VehiculoId = iif(\r",
				"    isNull(VehiculoId) || trim(toString(VehiculoId)) == '',\r",
				"    toString(null()),\r",
				"    trim(toString(VehiculoId))\r",
				"),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn1",
				"derivedColumn1 derive(VehiculoId = iif(     isNull(VehiculoId) || trim(VehiculoId) == '',     toString(null()),     concat(         trim(VehiculoId),         '-',         toString(year(FechaHoraInicio))     ) )) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}