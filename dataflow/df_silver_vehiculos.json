{
	"name": "df_silver_vehiculos",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(VehiculoId = upper(trim(VehiculoId)),",
				"          Placa = upper(trim(Placa)),",
				"          TipoVehiculo = upper(trim(TipoVehiculo)),",
				"          CapacidadEfectiva = toInteger(CapacidadEfectiva),",
				"          VigenciaDesde = iif(\r",
				"    isNull(VigenciaDesde),\r",
				"    toDate(null()),\r",
				"    iif(\r",
				"        instr(VigenciaDesde, '/') > 0,\r",
				"        toDate(VigenciaDesde, 'dd/MM/yyyy'),\r",
				"        iif(\r",
				"            length(VigenciaDesde) == 5,\r",
				"            addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(VigenciaDesde)),\r",
				"            toDate(VigenciaDesde, 'yyyy-MM-dd')\r",
				"        )\r",
				"    )\r",
				"),",
				"          VigenciaHasta = iif(\r",
				"    isNull(VigenciaHasta),\r",
				"    toDate(null()),\r",
				"    iif(\r",
				"        instr(VigenciaHasta, '/') > 0,\r",
				"        toDate(VigenciaHasta, 'dd/MM/yyyy'),\r",
				"        iif(\r",
				"            length(VigenciaHasta) == 5,\r",
				"            addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(VigenciaHasta)),\r",
				"            toDate(VigenciaHasta, 'yyyy-MM-dd')\r",
				"        )\r",
				"    )\r",
				"),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn1",
				"derivedColumn3 aggregate(groupBy(Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado,",
				"          VehiculoId),",
				"     Contador = count()) ~> aggregate1",
				"derivedColumn1 derive(VehiculoId = iif(\r",
				"    toString(VehiculoId) == '043' ||\r",
				"    toString(VehiculoId) == 'V-043',\r",
				"    iif(\r",
				"        toInteger(CapacidadEfectiva) == 60,\r",
				"        'V-043-1',\r",
				"        'V-043'\r",
				"    ),\r",
				"    iif(\r",
				"        left(toString(VehiculoId), 2) == 'V-',\r",
				"        toString(VehiculoId),\r",
				"        concat('V-', toString(VehiculoId))\r",
				"    )\r",
				")) ~> derivedColumn3",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as integer,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}